# Copy to .env (local) or /etc/transit-logger.env (server) and fill in.
# Plain KEY=value lines only: systemd reads this file too.

# 511.org token from https://511.org/open-data/token
API_511_KEY=

# 511 operator ID for AC Transit (verify with the gtfsoperators endpoint)
AGENCY_511=AC

# Seconds between polls of EACH 511 feed. Two feeds share one 60 req/hour
# limit: 150s -> 48 req/hour, leaving headroom. Lower it once 511 raises
# your limit (30s matches the Caltrans metric's 1-minute bins best).
INTERVAL_511_S=150

# AC Transit's own API token, from https://api.actransit.org/transit/
# (register, then activate). This is the main AC Transit source; the 511
# feeds above are kept as a backup. A brand-new token can fail intermittently
# for its first hour or so.
API_ACT_TOKEN=

# Seconds between polls of EACH AC Transit API feed. No published limit;
# 30s is polite and matches the Caltrans metric. Buses report every 15s.
INTERVAL_ACT_S=30

# BART has no key and no published limit.
INTERVAL_BART_S=30

# Where snapshots are written. Leave commented: defaults to ./data locally,
# and the systemd unit sets /var/lib/transit-logger on the server.
# DATA_DIR=./data

# Server only: S3 bucket the uploader moves files into
S3_BUCKET=

# Optional: healthchecks.io ping URL (emails you if logging stops)
HEALTHCHECK_URL=
